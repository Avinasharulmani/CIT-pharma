# Optional environment placeholders
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pharma_intelligence
ASR_PROVIDER=openai_whisper
ASR_MODEL_NAME=small
ASR_FALLBACK_MODEL_NAME=base
ASR_LANGUAGE=en
ASR_BEAM_SIZE=5
ASR_BEST_OF=5
ASR_TEMPERATURE=0
ASR_CONDITION_ON_PREVIOUS_TEXT=true
ASR_INITIAL_PROMPT=
ASR_CONTEXT_FROM_FILENAME=true
NO_SUMMARY_MESSAGE=No readable content found for summary generation.
NO_SPEECH_MESSAGE=No speech detected in the audio/video.

# Optional. Enables specific visual activity descriptions for video/image frames.
# OPENAI_API_KEY=your_api_key_here
# VISION_ACTIVITY_MODEL=gpt-4.1-mini
# VISION_ACTIVITY_FRAME_LIMIT=6
VIDEO_DESCRIPTION_ENABLED=false
LOCAL_VIDEO_DESCRIPTION_ENABLED=false
IMAGE_DESCRIPTION_ENABLED=false
LOCAL_IMAGE_DESCRIPTION_ENABLED=false
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_MODEL_ENABLED=false
KEYWORD_MODEL_ENABLED=false
MLR_GUIDELINE_PATH=
MLR_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MLR_EMBEDDING_LOCAL_FILES_ONLY=false
MLR_REVIEW_SIMILARITY_THRESHOLD=0.55
MLR_REVIEW_NEEDS_REVIEW_THRESHOLD=0.35
MLR_EVIDENCE_TERM_MATCH_RATIO=0.45
MLR_EVIDENCE_MIN_MATCHED_TERMS=2
MLR_TOP_MATCHES=3
MLR_REVIEW_SECTIONS=Medical Review,Legal Review,Regulatory Review
MLR_AI_JUDGMENT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
OPEN_WEIGHT_VLM_ENABLED=true
OPEN_WEIGHT_VLM_API_URL=http://localhost:8001/v1/chat/completions
OPEN_WEIGHT_VLM_API_KEY=
OPEN_WEIGHT_VLM_MODEL=nvidia/nemotron-nano-12b-v2-vl
OPEN_WEIGHT_VLM_TIMEOUT_SECONDS=60
OPEN_WEIGHT_VLM_CONFIDENCE=0.85
IMAGE_OCR_MODE=fast
IMAGE_EASYOCR_ENABLED=true
